{
    "offshore_waves": [
        {
            "name": "ERA5",
            "description": "ERA5 reanalysis data from the Earth Data Hub",
            "remote_url": "https://edh:{PAT}@data.earthdatahub.destine.eu/era5/reanalysis-era5-single-levels-ocean-v0.zarr",
            "variables": {
                "bulk": [
                    "swh",
                    "pp1d",
                    "mwd",
                    "dww"
                ],
                "sea": [
                    "shww",
                    "mpww",
                    "mdww",
                    "dwww"
                ],
                "swell1": [
                    "swh1",
                    "mwp1",
                    "mwd1"
                ],
                "swell2": [
                    "swh2",
                    "mwp2",
                    "mwd2"
                ],
                "swell3": [
                    "swh3",
                    "mwp3",
                    "mwd3"
                ]
            }
        },
        {
            "name": "WHACS",
            "description": "WHAC reanalysis data from David Gutiérrez Barceló (USGS) local storage",
            "remote_url": "NOT AVAILABLE",
            "variables": {
                "bulk": [
                    "hs",
                    "tp",
                    "dp",
                    "spr"
                ],
                "sea": [
                    "phs0",
                    "ptp0",
                    "pdp0",
                    "pspr0"
                ],
                "swell1": [
                    "phs1",
                    "ptp1",
                    "pdp1",
                    "pspr1"
                ],
                "swell2": [
                    "phs2",
                    "ptp2",
                    "pdp2",
                    "pspr2"
                ],
                "swell3": [
                    "phs3",
                    "ptp3",
                    "pdp3",
                    "pspr3"
                ]
            }
        }
    ],
    "offshore_sealevel": [
        {
            "name": "CODEC",
            "description": "CODEC reanalysis data from the GeoOcean Thredds server",
            "remote_url": "https://geoocean.unican.es/thredds/dodsC/aggregatedDatasets/CODEC.nc.html",
            "variables": [
                "waterlevel"
            ]
        }
