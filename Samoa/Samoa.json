{
    "name": "Samoa",
    "description": "Samoa hybrid wave-downscaling case (SnapWave + GPR metamodel)",
    "paths": {
        "aoi_file": "inputs/AoI_Polygons/Samoa_AoI.shp",
        "topobathy_file": "inputs/GRID/Samoa_300m.tif",
        "mesh_file": "inputs/GRID/Samoa_mesh.nc"
    },
    "offshore_waves": [
        {
            "name": "WHACS",
            "description": "WHACS reanalysis from D. Gutierrez Barcelo (USGS) for Samoa",
            "remote_url": null,
            "data_path": "inputs/WHACS/processed/WHACS_Samoa.zarr",
            "coordinates_path": "inputs/WHACS/Samoa_whacs.gpkg"
        }
    ],
    "onshore_waves": "inputs/LauriBuoys/LauriBuoys_coordinates.json",
    "simulations": {
        "goals_file": "inputs/goals/Samoa_goals.json",
        "metamodel_templates": "templates-metamodel",
        "dynamic_templates": "templates-dynamic",
        "metamodel_cases": "SnapWave_CASES_Metamodel",
        "dynamic_cases": "SnapWave_CASES_Dynamic",
        "num_samples_per_goal": 500,
        "bounds": {
            "tp": [
                1,
                15
            ],
            "spr": [
                1,
                45
            ],
            "wl": [
                -3.5,
                3.5
            ]
        },
        "output_sites_config": {
            "isobaths": [
                {
                    "name": "5m",
                    "level": -5.0,
                    "spacing": 0.1
                },
                {
                    "name": "10m",
                    "level": -10.0,
                    "spacing": 0.1
                },
                {
                    "name": "20m",
                    "level": -20.0,
                    "spacing": 0.1
                },
                {
                    "name": "50m",
                    "level": -50.0,
                    "spacing": 0.1
                }
            ],
            "polygons": [
                {
                    "name": "Apia",
                    "file": "inputs/AoI_Polygons/Apia_AoI.shp",
                    "wet_only": true
                }
            ],
            "include_buoys": true,
            "clip_to_aoi": true
        }
    },
    "metamodel": {
        "mda_candidates": [
            50,
            75,
            125,
            200,
            300,
            450
        ],
        "pca_variance": 0.95,
        "mda_inputs": [
            "tp",
            "dir",
            "spr",
            "wl"
        ],
        "directional_variables": [
            "dir"
        ],
        "vars_to_stack": [
            "hs",
            "tp",
            "dir_u",
            "dir_v"
        ],
        "validation": {
            "metrics_variables": [
                "hs",
                "tp",
                "dir"
            ]
        },
        "paths": {
            "mda_dir": "outputs/{goal}/mda_{mda_candidate}",
            "pca_dir": "outputs/{goal}/pca_{mda_candidate}",
            "gp_dir": "outputs/{goal}/gp_{mda_candidate}"
        }
    }
}