{
    "name": "Samoa",
    "description": "Samoa hybrid wave-downscaling case (SnapWave + GPR metamodel)",
    "paths": {
        "aoi_file": "inputs/AoI_Polygons/Samoa_AoI.shp",
        "topobathy_file": "inputs/GEBCO/Samoa_GEBCO.tiff",
        "mesh_file": "inputs/GRID/Samoa_mesh.nc"
    },
    "onshore_waves": "inputs/Observations/Samoa_observations.json",
    "offshore_waves": [],
    "simulations": {
        "goals_file": "inputs/Goals/Samoa_Goals.json",
        "metamodel_templates": "templates-metamodel",
        "dynamic_templates": "templates-dynamic",
        "metamodel_cases": "SnapWave_CASES_Metamodel",
        "dynamic_cases": "SnapWave_CASES_Dynamic",
        "num_samples_per_goal": 500,
        "bounds": {
            "tp": [
                1,
                15
            ],
            "spr": [
                1,
                45
            ],
            "wl": [
                -3.5,
                3.5
            ]
        },
        "output_sites_config": {
            "isobaths": [
                {
                    "name": "5m",
                    "level": -5.0,
                    "spacing": 0.1
                },
                {
                    "name": "10m",
                    "level": -10.0,
                    "spacing": 0.1
                },
                {
                    "name": "20m",
                    "level": -20.0,
                    "spacing": 0.1
                },
                {
                    "name": "50m",
                    "level": -50.0,
                    "spacing": 0.1
                }
            ],
            "polygons": [
                {
                    "name": "Apia",
                    "file": "inputs/AoI_Polygons/Apia_AoI.shp",
                    "wet_only": true
                }
            ],
            "include_buoys": true,
            "clip_to_aoi": true
        }
    },
    "metamodel": {
        "mda_candidates": [
            450
        ],
        "mda_inputs": [
            "tp",
            "dir",
            "spr",
            "wl"
        ],
        "mda_directional_variables": [
            "dir"
        ],
        "vars_to_predict": {
            "hs": {
                "vars_to_stack": [
                    "hs"
                ],
                "pca_variance": 0.99
            },
            "tp": "raw",
            "dir": {
                "vars_to_stack": [
                    "dir_u",
                    "dir_v"
                ],
                "pca_variance": 0.99
            },
            "spr": {
                "vars_to_stack": [
                    "spr"
                ],
                "pca_variance": 0.99
            }
        },
        "site_filter": {
            "hs_max": 10.0,
            "tp_min": 0.5
        },
        "validation": {
            "metrics_variables": [
                "hs",
                "tp",
                "dir",
                "spr"
            ]
        },
        "paths": {
            "pca_dir": "outputs/{goal}/pca_{mda_candidate}",
            "gp_dir": "outputs/{goal}/gp_{mda_candidate}"
        }
    }
}